{
  "name": "industrialist-calculateur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calculateur de production local pour le jeu Roblox Industrialist",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "maquette": "vitest run -c vitest.maquette.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "fetch-wiki": "node scripts/fetch-wiki.ts",
    "build-data": "node scripts/build-data.ts && node scripts/build-extension.ts",
    "data": "node scripts/fetch-wiki.ts && node scripts/build-data.ts && node scripts/build-extension.ts",
    "remarques": "node --disable-warning=ExperimentalWarning server/remarques.ts --local",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/deployer.ps1",
    "deploy:remarques": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/deployer.ps1 -Remarques",
    "remarques:mot-de-passe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/mot-de-passe.ps1",
    "remarques:discord": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/discord.ps1",
    "remarques:traducteur": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/traducteur.ps1",
    "deploy:retour": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pi/deployer.ps1 -Retour"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
